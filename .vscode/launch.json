{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Godot",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            // Linux
            "program": "/usr/bin/godot-mono",
            // Mac
            // "program": "/Applications/Godot.app/Contents/MacOS/Godot",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "args": [
                "--path",
                "${workspaceRoot}"
            ]
        }
    ]
}